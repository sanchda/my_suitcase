#!/bin/bash
# Claude Code status line (hybrid):
#   line 1 — ccusage: session/today/block cost, burn rate, context
#   line 2 — subscription limit bars: 5-hour and 7-day usage %, with a marker
#            showing how far through each window we are, and time-to-reset.
#
# Claude Code pipes the status-line JSON on stdin. Both lines degrade
# gracefully: no ccusage/npx -> no line 1; no rate_limits in the JSON ->
# no line 2.

input=$(cat)

CACHE_DIR="${XDG_CACHE_HOME:-$HOME/.cache}/cc-statusline"
LOCK_DIR="$CACHE_DIR/.lock"
LOCK_STALE_SECS=120

# --- line 1: ccusage ---------------------------------------------------------
# ccusage takes anywhere from a fraction of a second to tens of seconds
# depending on how much transcript history it has to chew through. Claude Code
# re-renders the status line on a timer and does NOT wait for the previous
# render to exit, so calling ccusage unguarded piles up processes whenever a
# render outlives the refresh interval — multiplied by every open session.
# Two guards:
#   1. a single-flight lock, so at most one ccusage runs across all sessions
#   2. a per-session cache, so a render that loses the lock prints the last
#      good line instead of blocking or printing nothing
# The cache is keyed by session_id because ccusage's session cost is per-session.

# Prefer an installed ccusage. Going through npx costs two extra processes and
# a registry check on every single refresh; npx stays as the fallback so a box
# without ccusage installed still gets a status line.
CCUSAGE_CMD=""
if command -v ccusage >/dev/null 2>&1; then
  CCUSAGE_CMD="ccusage"
elif command -v npx >/dev/null 2>&1; then
  CCUSAGE_CMD="npx -y ccusage"
fi

# mtime <path> -> epoch seconds (BSD stat, then GNU stat)
mtime() {
  stat -f %m "$1" 2>/dev/null || stat -c %Y "$1" 2>/dev/null
}

cache_file=""
if command -v jq >/dev/null 2>&1; then
  session_id=$(printf '%s' "$input" | jq -r '.session_id // empty' 2>/dev/null \
    | tr -cd 'A-Za-z0-9._-')
  [ -n "$session_id" ] && cache_file="$CACHE_DIR/line1-$session_id"
fi

if [ -n "$CCUSAGE_CMD" ]; then
  mkdir -p "$CACHE_DIR" 2>/dev/null

  # Reclaim a lock left behind by a render that was killed mid-flight.
  if [ -d "$LOCK_DIR" ]; then
    lock_ts=$(mtime "$LOCK_DIR")
    if [ -n "$lock_ts" ] && [ $(( $(date +%s) - lock_ts )) -gt "$LOCK_STALE_SECS" ]; then
      rmdir "$LOCK_DIR" 2>/dev/null
    fi
  fi

  # mkdir is the atomic test-and-set here: macOS has no flock(1).
  if mkdir "$LOCK_DIR" 2>/dev/null; then
    trap 'rmdir "$LOCK_DIR" 2>/dev/null' EXIT
    line1=$(printf '%s' "$input" | $CCUSAGE_CMD statusline 2>/dev/null)
    if [ -n "$line1" ]; then
      printf '%s\n' "$line1"
      if [ -n "$cache_file" ]; then
        tmp=$(mktemp "$CACHE_DIR/.tmp.XXXXXX" 2>/dev/null) \
          && printf '%s\n' "$line1" > "$tmp" \
          && mv "$tmp" "$cache_file"
      fi
      # Sessions are ephemeral; don't let their cache files accumulate forever.
      find "$CACHE_DIR" -name 'line1-*' -mtime +7 -delete 2>/dev/null
    elif [ -n "$cache_file" ] && [ -s "$cache_file" ]; then
      cat "$cache_file"
    fi
  elif [ -n "$cache_file" ] && [ -s "$cache_file" ]; then
    cat "$cache_file"
  fi
fi

# --- line 2: rate-limit bars -------------------------------------------------
command -v jq >/dev/null 2>&1 || exit 0

FIVE_H=$(printf '%s' "$input" | jq -r '.rate_limits.five_hour.used_percentage // empty')
WEEK=$(printf '%s' "$input" | jq -r '.rate_limits.seven_day.used_percentage // empty')
FIVE_H_RESETS=$(printf '%s' "$input" | jq -r '.rate_limits.five_hour.resets_at // empty')
WEEK_RESETS=$(printf '%s' "$input" | jq -r '.rate_limits.seven_day.resets_at // empty')

GREY='\033[90m'
WHITE='\033[97m'
BLUE='\033[94m'
NC='\033[0m'

# make_bar <used_pct> <resets_at_epoch> <window_secs>
# Draws a 10-cell bar filled to used_pct. The cell at the current time position
# within the window is highlighted white, so you can see usage vs. elapsed time.
make_bar() {
  local pct=$1 resets_at=$2 window_secs=$3
  local filled=$(( ${pct%.*} / 10 ))
  local time_pos=""

  if [[ "$resets_at" =~ ^[0-9]+$ ]] && [ -n "$window_secs" ] && [ "$window_secs" -gt 0 ]; then
    local now_ts remaining
    now_ts=$(date +%s)
    remaining=$(( resets_at - now_ts ))
    time_pos=$(( (window_secs - remaining) * 10 / window_secs ))
    [ "$time_pos" -lt 0 ] && time_pos=0
    [ "$time_pos" -gt 9 ] && time_pos=9
  fi

  local bar="" i
  for i in $(seq 0 9); do
    if [ -n "$time_pos" ] && [ "$i" -eq "$time_pos" ]; then
      if [ "$i" -lt "$filled" ]; then
        bar="${bar}${WHITE}█${GREY}"
      else
        bar="${bar}${WHITE}░${GREY}"
      fi
    elif [ "$i" -lt "$filled" ]; then
      bar="${bar}█"
    else
      bar="${bar}░"
    fi
  done
  printf '%s' "$bar"
}

# format_reset <resets_at_epoch> -> "4d6h" / "3h12m" / "45m"
format_reset() {
  local resets_at=$1
  [[ "$resets_at" =~ ^[0-9]+$ ]] || { printf ''; return; }
  local now_ts remaining days hours mins
  now_ts=$(date +%s)
  remaining=$(( resets_at - now_ts ))
  [ "$remaining" -lt 0 ] && remaining=0
  days=$(( remaining / 86400 ))
  hours=$(( (remaining % 86400) / 3600 ))
  mins=$(( (remaining % 3600) / 60 ))
  if [ "$days" -gt 0 ]; then
    printf '%dd%dh' "$days" "$hours"
  elif [ "$hours" -gt 0 ]; then
    printf '%dh%dm' "$hours" "$mins"
  else
    printf '%dm' "$mins"
  fi
}

FIVE_H_SEG=""
WEEK_SEG=""

if [ -n "$FIVE_H" ]; then
  bar=$(make_bar "$FIVE_H" "$FIVE_H_RESETS" $(( 5 * 3600 )))
  reset=$(format_reset "$FIVE_H_RESETS")
  FIVE_H_SEG="${GREY}5h: ${FIVE_H%.*}% ${NC}${bar}${NC}"
  [ -n "$reset" ] && FIVE_H_SEG="${FIVE_H_SEG}${GREY} (${BLUE}${reset}${NC}${GREY})${NC}"
fi

if [ -n "$WEEK" ]; then
  bar=$(make_bar "$WEEK" "$WEEK_RESETS" $(( 7 * 24 * 3600 )))
  reset=$(format_reset "$WEEK_RESETS")
  WEEK_SEG="${GREY}7d: ${WEEK%.*}% ${NC}${bar}${NC}"
  [ -n "$reset" ] && WEEK_SEG="${WEEK_SEG}${GREY} (${BLUE}${reset}${NC}${GREY})${NC}"
fi

if [ -n "$FIVE_H_SEG" ] && [ -n "$WEEK_SEG" ]; then
  printf '%b\n' "${FIVE_H_SEG} | ${WEEK_SEG}"
elif [ -n "$FIVE_H_SEG" ]; then
  printf '%b\n' "$FIVE_H_SEG"
elif [ -n "$WEEK_SEG" ]; then
  printf '%b\n' "$WEEK_SEG"
fi
